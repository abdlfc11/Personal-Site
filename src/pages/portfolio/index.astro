---
import Layout from "../../layouts/Layout.astro";

import Header from "../../components/shared/Header.astro";
import Hero from "../../components/portfolio/Hero.astro";
import About from "../../components/portfolio/About.astro";
import TechStack from "../../components/portfolio/TechStack.astro";
import ProjectCard from "../../components/portfolio/ProjectCard.astro";
import Contact from "../../components/portfolio/Contact.astro";
import Footer from "../../components/shared/Footer.astro";
---

<Layout
    title="Portfolio — Abdulrahman Sultan"
    description="Projects and work by Abdulrahman Sultan, a Computer Science student building Crest and other end-to-end software."
>
    <Header
        links={[
            { label: "Projects", href: "#projects" },
            { label: "About", href: "#about" },
            { label: "Contact", href: "#contact" },
            { label: "CV", href: "https://abdul-sultan.com/CS.pdf", external: true },
        ]}
    />

    <main id="top">
        <Hero />

        <About />

        <TechStack />

        <section class="projects" id="projects">
            <div class="container">
                <h2 class="section-label">Projects</h2>

                <div class="projects-container">

                    <ProjectCard 
                        projectCard={
                            {
                                description: "A custom A* algorithm plans realistic hiking routes in Cumbria using elevation data and OSM tags.",
                                tags: ["Python", "FastAPI", "PostgreSQL"],
                                name: "Crestr",
                                links: {
                                    githubLink: "https://github.com/abdlfc11/Crestr-Hiking-App",
                                    hasLiveLink: true,
                                    liveLink: "https://app.crestr.co.uk"
                                },
                                image: {
                                    link: "https://images.crestr.co.uk/Main-UI.jpeg",
                                    altText: "Crestr UI"
                                }
                            }
                        }
                    />
                </div>
            </div>
        </section>

        <Contact />
    </main>

    <Footer />
</Layout>
