---
import Layout from "../../layouts/Layout.astro";

import Header from "../../components/shared/Header.astro";
import Footer from "../../components/shared/Footer.astro";
import PostCard from "../../components/blog/PostCard.astro";

import "../../styles/blog/blog-index.css";

const posts = [
    {
        title: "Learning how to code by using my own app",
        description:
            "How building and using my own hiking app, Crestr, taught me to code.",
        date: "22-11-2026",
        href: "/blog/learning-to-code-by-using-my-own-app",
        tags: ["Crestr", "Full-Stack", "Learning"],
    },
    {
        title: "Notetaking as a habit: How it has helped me",
        description: "What I learnt from consistently note-taking for a month.",
        date: "28-08-2026",
        href: "/blog/note-taking",
        tags: ["Life", "Learning", "Habits"],
    },
    {
        title: "Overworking Myself: Lessons learnt from constant output and learning without time for rest",
        description:
            "What I learnt from having the hardest academic years of my life, how it got better, and how I'll prevent this in the future.",
        date: "07-08-2026",
        href: "/blog/overworking-myself",
        tags: ["Studying", "Life", "Wellbeing"],
    },
    {
        title: "Building Crestr: Lessons from a Solo Full-Stack Project",
        description:
            "What I learned shipping a free open-source hiking route planner end-to-end.",
        date: "05-08-2026",
        href: "/blog/building-crestr",
        tags: ["Crestr", "Open-Source", "Full-Stack"],
    },
];
---

<Layout
    title="Writing"
    description="Thoughts on coding, university, hiking, photography, fitness, and the projects I'm building."
>
    <Header links={[{ label: "Home", href: "/" }]} />

    <main id="top">
        <section class="blog-hero">
            <div class="container">
                <h1 class="blog-hero-title">Writing</h1>
                <p class="blog-hero-desc">
                    Thoughts on coding, university, hiking, photography,
                    fitness, and the projects I'm building.
                </p>
            </div>
        </section>

        <section class="posts-section">
            <div class="container">
                <h2 class="section-label">Articles</h2>

                {posts.length > 0 ? (
                    <div class="posts-grid">
                        {posts.map((post) => (
                            <PostCard
                                title={post.title}
                                description={post.description}
                                date={post.date}
                                href={post.href}
                                tags={post.tags}
                            />
                        ))}
                    </div>
                ) : (
                    <div class="posts-empty">
                        <p>No articles yet.</p>
                        <p>The first ones are on the way.</p>
                    </div>
                )}
            </div>
        </section>
    </main>

    <Footer />
</Layout>
