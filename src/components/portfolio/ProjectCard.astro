---
import { Icon } from "astro-icon/components";
import "../../styles/components/project-card.css";

interface ProjectImage {
    link: string,
    altText: string
};

interface ProjectLinks {
    hasLiveLink: boolean
    liveLink?: string,
    githubLink: string
};

interface ProjectCard {
    description: string,
    tags: string[],
    name: string,
    links: ProjectLinks,
    image: ProjectImage
};

interface Props {
    projectCard: ProjectCard
};

const {
    projectCard
} = Astro.props;
---

<div class="project-card">

    <div class="project-card-media">

        <img
            src={projectCard.image.link}
            alt={projectCard.image.altText}
        />

    </div>


    <div class="project-card-body">

        <div class="project-card-heading-row">

                {
                    projectCard.links.hasLiveLink ? (
                        <h3 class="project-card-heading text-link">
                            <a target="_blank" href={projectCard.links.liveLink}>
                                {projectCard.name} <span class="project-card-external-link"><Icon name="octicon:link-external" size={20}/></span>
                            </a>
                        </h3>
                    ) : (
                        <h3 class="project-card-heading">
                            <p>{projectCard.name}</p>
                        </h3>
                    )
                }
            
            <a class="project-card-github" target="_blank" rel="noopener" href={projectCard.links.githubLink} aria-label={"View " + projectCard.name + " on GitHub."}>
                <Icon name="simple-icons:github" size={20}/>
            </a>
        </div>


        <p class="project-card-text">{projectCard.description}</p>


        <ul class="project-card-tags">
            {
                projectCard.tags.map((tag) => (
                    <li class="project-tag">
                        {tag}
                    </li>
                ))
            }
        </ul>


    </div>

</div>