---
import "../../styles/components/hero.css";
---

<section class="hero">
    <div class="container">
        <h1 class="hero-name">Abdulrahman Sultan</h1>

        <p class="eyebrow">Software Developer</p>

        <p class="hero-bio">
            I'm an 18-year-old developer in his first year of Computer Science
            at the University of Manchester. I like building useful tools and
            solving problems that affect the people around me.
        </p>

        <div class="hero-actions">
            <a href="#projects" class="btn btn-primary">
                View projects
            </a>

            <a
                href="https://abdul-sultan.com/CS.pdf"
                class="btn btn-secondary"
                target="_blank"
            >
                View CV
            </a>

            <a href="#contact" class="btn btn-secondary">
                Get in touch
            </a>
        </div>
    </div>
</section>
