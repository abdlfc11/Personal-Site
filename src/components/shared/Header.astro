---
import "../../styles/components/navbar.css"
import SocialLinks from "./socialLinks.astro"
import ThemeToggle from "./themeToggle.astro" 

interface NavLink {
    label: string;
    href: string;
    external?: boolean;
    notAvailable?: boolean;
}

interface Props {
    links?: NavLink[];
}

const {
    links = []
} = Astro.props;
---

<header class="site-header">
    <div class="nav-container">
        <a href="/" class="nav-logo">Abdulrahman Sultan</a>

        <div class="nav-right">
            <nav class="nav-menu" id="nav-menu">
                <ul class="nav-links">
                    {links.map((link) => (
                        <li>
                            <a
                                href={link.href}
                                target={link.external ? "_blank" : undefined}
                                rel={link.external ? "noopener" : undefined}
                                class={link.notAvailable ? "not-available" : ""}
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>

                <SocialLinks />
            </nav>

            <ThemeToggle />
        </div>
    </div>
</header>

